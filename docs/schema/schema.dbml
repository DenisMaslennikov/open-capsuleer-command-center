// OpenCapsuleerCommandCenter — database schema contract
// generated by schema_design.py; edit the contract, not this file

Enum skip_reason {
  missing_scope
  missing_role
  token_revoked
  structure_inaccessible
}

Enum sync_status {
  ok
  not_modified
  skipped
  error
}

Enum sync_source {
  skills
  skill_queue
  attributes
  implants
  clones
  wallet
  roles
  assets
  blueprints
  industry_jobs
  orders
  mail
  game_notifications
  killmails
}

Enum plan_entry_source {
  skill
  ship
  certificate
  merge
  import
}

Enum component_source {
  stock
  market
  build
}

Enum blueprint_activity {
  manufacturing
  research_time
  research_material
  copying
  invention
  reaction
}

Enum industry_job_status {
  active
  paused
  ready
  delivered
  cancelled
  reverted
}

Enum order_kind {
  buy
  sell
}

Enum order_state {
  active
  expired
  cancelled
  fulfilled
}

Enum mail_recipient_type {
  character
  corporation
  alliance
  mailing_list
}

Enum killmail_role {
  victim
  attacker
  final_blow
}

Enum channel_kind {
  web_push
  telegram
  discord
  whatsapp
  max
}

Enum event_kind {
  skill_completed
  queue_empty
  industry_job_completed
  order_undercut
  mail_received
}

Enum delivery_status {
  pending
  sent
  failed
  dead
}

TableGroup accounts {
  "accounts" "sessions" "characters" "character_tokens" "character_scopes" "character_roles" "corporations" "corporation_divisions"
}

TableGroup sync {
  "sync_states"
}

TableGroup sde {
  "sde_builds" "categories" "groups" "types" "skills" "skill_requirements" "implants" "certificates" "certificate_skills" "ship_masteries" "blueprints" "blueprint_activities" "blueprint_materials" "blueprint_products" "regions" "solar_systems" "stations"
}

TableGroup characters {
  "character_sheets" "character_skills" "character_skill_queue" "character_implants" "jump_clones" "jump_clone_implants"
}

TableGroup skill_plans {
  "skill_plans" "skill_plan_entries"
}

TableGroup assets {
  "assets" "structures"
}

TableGroup mail {
  "mails" "mail_recipients" "mailbox_entries" "mail_labels" "mailbox_entry_labels" "mailing_lists" "game_notifications"
}

TableGroup industry {
  "blueprint_items" "industry_jobs" "production_plans" "production_plan_targets" "production_plan_nodes" "production_plan_runs"
}

TableGroup market {
  "market_orders" "watched_items" "undercut_events"
}

TableGroup market_data {
  "market_book_orders" "market_prices" "market_history"
}

TableGroup killmails {
  "killmails" "killmail_participants" "killmail_items" "character_killmails"
}

TableGroup notifications {
  "notification_recipients" "push_subscriptions" "notification_rules" "notification_rule_recipients" "notification_rule_characters" "notification_events" "notification_deliveries"
}

TableGroup esi_cache {
  "esi_responses"
}

Table "accounts" {
  "id" bigint [pk, not null, increment]
  "last_login_at" timestamptz [note: 'Время последнего успешного входа через SSO. null — вход ещё не завершён.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Аккаунт пользователя приложения — корень права на забвение. Удаление строки каскадно уносит все пользовательские данные.'
}

Table "sessions" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "token_hash" bytea [not null, unique, note: 'SHA-256 от cookie-токена сессии. Сам токен в базе не хранится; это не шифротекст, поэтому суффикса _encrypted нет.']
  "expires_at" timestamptz [not null, note: 'Абсолютный срок жизни сессии.']
  "last_seen_at" timestamptz [not null, default: `now()`, note: 'Время последнего запроса с этой сессией.']
  "user_agent" text [note: 'Показывается пользователю в списке активных сессий.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("account_id") [name: 'ix_sessions_account'] }
  indexes { ("expires_at") [name: 'ix_sessions_expires_at'] }
  Note: 'Сессии входа в веб-приложение; хранится только хэш токена сессии.'
}

Table "characters" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "character_id" bigint [not null, unique, note: 'Игровой ID персонажа EVE. Уникален глобально; FK нет.']
  "owner_hash" text [not null, note: 'CharacterOwnerHash из SSO. Смена значения означает передачу персонажа другому игроку: токены и данные персонажа сбрасываются.']
  "name" text [not null]
  "corporation_id" bigint [not null, note: 'Игровой ID текущей корпорации персонажа; FK нет.']
  "alliance_id" bigint [note: 'Игровой ID альянса; null — корпорация вне альянса.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("account_id", "corporation_id") [name: 'ix_characters_account_corporation'] }
  indexes { ("account_id", "id") [unique, name: 'uq_characters_account_id_id'] }
  Note: 'Персонаж EVE, привязанный к аккаунту. Персонаж принадлежит не более чем одному аккаунту.'
}

Table "character_tokens" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null, unique, note: 'FK на characters.id (внутренний id), а не игровой character_id.']
  "refresh_token_encrypted" bytea [not null, note: 'Шифротекст refresh-токена.']
  "access_token_encrypted" bytea [note: 'Шифротекст текущего access-токена; null — ещё не получен или сброшен.']
  "access_token_expires_at" timestamptz [note: 'Обязателен вместе с access_token_encrypted.']
  "revoked_at" timestamptz [note: 'Время, когда SSO отверг refresh-токен (invalid_grant). Не null — нужен повторный вход.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Зашифрованные OAuth-токены ESI персонажа; одна строка на персонажа.'
}

Table "character_scopes" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null, note: 'FK на characters.id (внутренний id).']
  "scope" varchar(100) [not null, note: 'Строка скоупа ESI как есть, например esi-skills.read_skills.v1.']
  "created_at" timestamptz [not null, default: `now()`]
  Note: 'Скоупы ESI, фактически выданные персонажем при последнем входе; из них вычисляются capabilities.'
}

Table "character_roles" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null, note: 'FK на characters.id (внутренний id).']
  "role" varchar(64) [not null, note: 'Имя роли ESI как есть (Director, Accountant, Factory_Manager...) из поля roles ответа /characters/{id}/roles.']
  "created_at" timestamptz [not null, default: `now()`]
  Note: 'Корпоративные роли персонажа из ESI; определяют доступ к корпоративным данным.'
}

Table "corporations" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "corporation_id" bigint [not null, note: 'Игровой ID корпорации; FK нет.']
  "name" text [not null]
  "ticker" varchar(5) [not null]
  "alliance_id" bigint [note: 'Игровой ID альянса; null — вне альянса.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Корпорация персонажей аккаунта; хранится отдельно в каждом аккаунте и является владельцем корпоративных данных.'
}

Table "corporation_divisions" {
  "id" bigint [pk, not null, increment]
  "corporation_id" bigint [not null, note: 'FK на corporations.id (внутренний id), а не игровой corporation_id.']
  "division" smallint [not null, note: 'Номер дивизиона 1–7; соответствует флагам CorpSAG1..7 у ассетов и номеру кошелька.']
  "hangar_name" text [note: 'Название ангара; null — не задано в игре.']
  "wallet_name" text [note: 'Название кошелька; null — не задано (дивизион 1 в игре — Master Wallet).']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Названия корпоративных дивизионов (ангары и кошельки) с номерами 1–7.'
}

Table "sync_states" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [note: 'Владелец-персонаж (FK на characters.id, не игровой character_id). Заполнен ровно один из character_id и corporation_id']
  "corporation_id" bigint [note: 'Владелец-корпорация (FK на corporations.id, не игровой corporation_id)']
  "source" varchar(32) [not null, note: 'Значение enum sync_source']
  "status" varchar(16) [not null, note: 'Значение enum sync_status: итог последней завершённой попытки']
  "skip_reason" varchar(32) [note: 'Значение enum skip_reason; заполнено тогда и только тогда, когда status =  skipped ']
  "error_message" text [note: 'Краткий текст ошибки (HTTP-код и сообщение ESI). Заполнено только при status =  error ']
  "consecutive_failures" integer [not null, default: `0`, note: 'Число ошибок подряд, используется для экспоненциального backoff. Сбрасывается в 0 при ok или not_modified']
  "last_attempt_at" timestamptz [not null, default: `now()`, note: 'Время последней попытки с любым итогом']
  "last_success_at" timestamptz [note: 'Время последней попытки со статусом ok или not_modified, то есть свежесть данных для UI; null, если успеха не было']
  "next_attempt_at" timestamptz [not null, note: 'Когда планировщику запускать источник снова: из Expires ESI, backoff после error или повторной проверки доступа после skipped']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("next_attempt_at") [name: 'ix_sync_states_next_attempt'] }
  indexes { ("corporation_id") [name: 'ix_sync_states_corporation'] }
  Note: 'Одна строка на пару «владелец + источник»: время и итог последней попытки, причина пропуска, время следующей попытки'
}

Table "sde_builds" {
  "id" bigint [pk, not null, increment]
  "build_number" bigint [not null, unique, note: 'Номер билда SDE от CCP']
  "released_on" date [note: 'Дата выпуска билда CCP, если она известна из архива']
  "source_checksum" varchar(128) [note: 'Хэш архива SDE (hex) для проверки повторного импорта']
  "started_at" timestamptz [not null, default: `now()`]
  "completed_at" timestamptz [note: 'null — импорт не завершён или упал; текущая версия = max(build_number) where completed_at is not null']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Журнал импортов SDE: номер билда CCP и время начала и окончания импорта; текущая версия — последняя завершённая'
}

Table "categories" {
  "id" bigint [pk, not null, note: 'Игровой categoryID; не identity']
  "name_en" text [not null]
  "name_ru" text [note: 'null, если в SDE нет русской локализации']
  "published" boolean [not null, default: `false`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Категории типов SDE (корабли, модули, скилы, чертежи…)'
}

Table "groups" {
  "id" bigint [pk, not null, note: 'Игровой groupID; не identity']
  "category_id" bigint [not null]
  "name_en" text [not null]
  "name_ru" text
  "published" boolean [not null, default: `false`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("category_id") [name: 'ix_groups_category'] }
  Note: 'Группы типов SDE внутри категорий'
}

Table "types" {
  "id" bigint [pk, not null, note: 'Игровой typeID; не identity. На это значение ссылаются type_id пользовательских таблиц без FK']
  "group_id" bigint [not null]
  "market_group_id" bigint [note: 'Игровой marketGroupID без FK (таблицы рыночных групп нет); null — тип не торгуется']
  "name_en" text [not null]
  "name_ru" text
  "description_en" text
  "description_ru" text
  "volume" numeric(20,4) [note: 'Объём, м³']
  "packaged_volume" numeric(20,4) [note: 'Объём в упакованном виде, м³']
  "portion_size" integer [not null, default: `1`]
  "base_price" numeric(20,2) [note: 'Базовая цена CCP, ISK; для скилов — цена книги в расчёте плана']
  "published" boolean [not null, default: `false`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("group_id") [name: 'ix_types_group'] }
  indexes { ("name_en") [name: 'ix_types_name_en'] }
  indexes { ("name_ru") [name: 'ix_types_name_ru'] }
  Note: 'Все типы предметов SDE: имя, группа, объём, базовая цена'
}

Table "skills" {
  "type_id" bigint [pk, not null, note: 'PK = typeID скила']
  "rank" smallint [not null, note: 'Множитель времени обучения (training time multiplier)']
  "primary_attribute" varchar(16) [not null, note: 'Одно из: intelligence, memory, perception, willpower, charisma']
  "secondary_attribute" varchar(16) [not null, note: 'Одно из: intelligence, memory, perception, willpower, charisma']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Скилы: ранг и атрибуты обучения для расчёта времени и SP'
}

Table "skill_requirements" {
  "skill_type_id" bigint [pk, not null, note: 'Скил, у которого есть требование']
  "required_type_id" bigint [pk, not null, note: 'Требуемый скил']
  "required_level" smallint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("required_type_id") [name: 'ix_skill_requirements_required'] }
  Note: 'Пререквизиты скилов: какой уровень какого скила нужен для изучения скила'
}

Table "implants" {
  "type_id" bigint [pk, not null, note: 'PK = typeID импланта']
  "slot" smallint [not null, note: 'Слот импланта, 1–10']
  "perception_bonus" smallint [not null, default: `0`]
  "memory_bonus" smallint [not null, default: `0`]
  "willpower_bonus" smallint [not null, default: `0`]
  "intelligence_bonus" smallint [not null, default: `0`]
  "charisma_bonus" smallint [not null, default: `0`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Импланты: слот и бонусы к атрибутам для расчёта скорости обучения'
}

Table "certificates" {
  "id" bigint [pk, not null, note: 'Игровой certificateID; не identity']
  "name_en" text [not null]
  "name_ru" text
  "description_en" text
  "description_ru" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Сертификаты SDE: наборы уровней скилов по ступеням мастерства'
}

Table "certificate_skills" {
  "id" bigint [pk, not null, increment]
  "certificate_id" bigint [not null]
  "skill_type_id" bigint [not null]
  "mastery_level" smallint [not null, note: 'Ступень: 1 basic, 2 standard, 3 improved, 4 advanced, 5 elite']
  "required_level" smallint [not null, note: 'Нужный уровень скила; записи с уровнем 0 из SDE не импортируются']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("skill_type_id") [name: 'ix_certificate_skills_skill'] }
  Note: 'Требуемый уровень скила для каждой ступени мастерства сертификата'
}

Table "ship_masteries" {
  "id" bigint [pk, not null, increment]
  "ship_type_id" bigint [not null]
  "certificate_id" bigint [not null]
  "mastery_level" smallint [not null, note: 'Ступень мастерства корабля 1–5; сертификат берётся той же ступени']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("certificate_id") [name: 'ix_ship_masteries_certificate'] }
  Note: 'Сертификаты, составляющие каждую ступень мастерства корабля'
}

Table "blueprints" {
  "type_id" bigint [pk, not null, note: 'PK = typeID чертежа']
  "max_production_limit" integer [not null, note: 'Максимум прогонов у одной копии']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Чертежи SDE: лимит прогонов копии'
}

Table "blueprint_activities" {
  "id" bigint [pk, not null, increment]
  "blueprint_type_id" bigint [not null]
  "activity" blueprint_activity [not null, note: 'Enum blueprint_activity']
  "time_seconds" integer [not null, note: 'Базовое время одного прогона без бонусов, секунды']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Доступные активности чертежа и базовое время одного прогона'
}

Table "blueprint_materials" {
  "id" bigint [pk, not null, increment]
  "blueprint_type_id" bigint [not null]
  "activity" blueprint_activity [not null]
  "material_type_id" bigint [not null]
  "quantity" bigint [not null, note: 'Количество на один прогон без учёта ME']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("material_type_id") [name: 'ix_blueprint_materials_material'] }
  Note: 'Входные материалы активности чертежа на один прогон'
}

Table "blueprint_products" {
  "id" bigint [pk, not null, increment]
  "blueprint_type_id" bigint [not null]
  "activity" blueprint_activity [not null]
  "product_type_id" bigint [not null]
  "quantity" bigint [not null, note: 'Количество за один прогон']
  "probability" numeric(5,4) [note: 'Базовая вероятность успеха (0–1); заполняется только для invention']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("product_type_id", "activity") [name: 'ix_blueprint_products_product'] }
  Note: 'Продукты активности чертежа: что и сколько получается за прогон, вероятность для invention'
}

Table "regions" {
  "id" bigint [pk, not null, note: 'Игровой regionID; не identity']
  "name_en" text [not null]
  "name_ru" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Регионы New Eden'
}

Table "solar_systems" {
  "id" bigint [pk, not null, note: 'Игровой solarSystemID; не identity']
  "region_id" bigint [not null]
  "constellation_id" bigint [not null, note: 'Игровой constellationID без FK (таблицы созвездий нет)']
  "name_en" text [not null]
  "name_ru" text
  "security_status" numeric(6,5) [not null, note: 'Точный security status из SDE, от −1 до 1']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("region_id") [name: 'ix_solar_systems_region'] }
  Note: 'Солнечные системы с регионом и уровнем безопасности'
}

Table "stations" {
  "id" bigint [pk, not null, note: 'Игровой stationID; не identity']
  "solar_system_id" bigint [not null]
  "type_id" bigint [not null, note: 'typeID станции без FK, только для отображения']
  "owner_corporation_id" bigint [note: 'Игровой corporation_id NPC-владельца без FK']
  "name_en" text [not null]
  "name_ru" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("solar_system_id") [name: 'ix_stations_solar_system'] }
  Note: 'NPC-станции: локации ассетов, ордеров и работ (цитадели — в assets.structures)'
}

Table "character_sheets" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null, unique, note: 'FK на characters.id (наша строка), а не игровой character_id']
  "charisma" smallint [note: 'null, пока источник attributes не синхронизирован']
  "intelligence" smallint [note: 'null, пока источник attributes не синхронизирован']
  "memory" smallint [note: 'null, пока источник attributes не синхронизирован']
  "perception" smallint [note: 'null, пока источник attributes не синхронизирован']
  "willpower" smallint [note: 'null, пока источник attributes не синхронизирован']
  "bonus_remaps" smallint [note: 'Число доступных бонусных ремапов (ESI attributes.bonus_remaps)']
  "last_remap_date" timestamptz
  "accrued_remap_cooldown_date" timestamptz [note: 'Момент, когда станет доступен следующий обычный ремап']
  "total_sp" bigint [note: 'Из ESI skills.total_sp; null, пока источник skills не синхронизирован']
  "unallocated_sp" bigint [note: 'Нераспределённые SP; null, если ESI поле не вернул или skills не синхронизирован']
  "wallet_balance" numeric(20,2) [note: 'Баланс ISK; null, пока источник wallet не синхронизирован']
  "home_location_id" bigint [note: 'Игровой id станции или структуры домашнего клона, без FK']
  "home_location_type" varchar(16) [note: ' station  или  structure  (ESI clones.home_location.location_type)']
  "last_clone_jump_date" timestamptz
  "last_station_change_date" timestamptz [note: 'Последняя смена домашней станции']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Сводная карточка персонажа: атрибуты и ремапы, SP, баланс кошелька, домашняя станция и даты прыжков клонов'
}

Table "character_skills" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null]
  "type_id" bigint [not null, note: 'Игровой type_id скила (ESI skill_id), без FK на SDE']
  "active_skill_level" smallint [not null, note: 'Действующий уровень (может быть ниже обученного для альфа-клона)']
  "trained_skill_level" smallint [not null]
  "skillpoints_in_skill" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Выученные скилы персонажа: активный и обученный уровень, SP в скиле'
}

Table "character_skill_queue" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null]
  "queue_position" integer [not null, note: 'Позиция в очереди из ESI, начиная с 0']
  "type_id" bigint [not null, note: 'Игровой type_id скила, без FK на SDE']
  "finished_level" smallint [not null, note: 'Уровень, который будет достигнут по завершении записи']
  "start_date" timestamptz [note: 'null, если очередь на паузе']
  "finish_date" timestamptz [note: 'null, если очередь на паузе']
  "training_start_sp" bigint
  "level_start_sp" bigint
  "level_end_sp" bigint
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("finish_date") [name: 'ix_character_skill_queue_finish_date'] }
  Note: 'Очередь обучения персонажа с временами начала и окончания каждого уровня'
}

Table "character_implants" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null]
  "type_id" bigint [not null, note: 'Игровой type_id импланта; слот и бонусы берутся из SDE implants, без FK']
  "created_at" timestamptz [not null, default: `now()`]
  Note: 'Импланты, установленные в активный клон персонажа'
}

Table "jump_clones" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null]
  "jump_clone_id" bigint [not null, note: 'Игровой id джамп-клона из ESI']
  "location_id" bigint [not null, note: 'Игровой id станции или структуры, без FK']
  "location_type" varchar(16) [not null, note: ' station  или  structure ']
  "name" varchar(255) [note: 'Пользовательское название клона в игре; ESI может не вернуть']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Джамп-клоны персонажа с их локацией и названием'
}

Table "jump_clone_implants" {
  "id" bigint [pk, not null, increment]
  "jump_clone_id" bigint [not null, note: 'FK на jump_clones.id (наш суррогатный id), НЕ игровой jump_clones.jump_clone_id']
  "type_id" bigint [not null, note: 'Игровой type_id импланта, без FK на SDE']
  "created_at" timestamptz [not null, default: `now()`]
  Note: 'Импланты, установленные в конкретном джамп-клоне'
}

Table "skill_plans" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null, note: 'Владелец плана и путь до accounts.id для права на забвение']
  "character_id" bigint [note: 'Персонаж, для которого считается план (characters.id, а не игровой character_id). NULL означает, что план не привязан или персонаж удалён из аккаунта, а сам план сохраняется.']
  "name" varchar(100) [not null]
  "description" text [note: 'Свободная заметка пользователя']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`, note: 'Обновляется и при любом изменении записей плана']
  indexes { ("character_id") [name: 'ix_skill_plans_character'] }
  Note: 'Именованный план обучения аккаунта, по желанию привязанный к персонажу'
}

Table "skill_plan_entries" {
  "id" bigint [pk, not null, increment]
  "skill_plan_id" bigint [not null]
  "type_id" bigint [not null, note: 'Игровой type_id скила. FK на SDE нет по соглашению: реимпорт SDE не должен ломать планы']
  "level" smallint [not null, note: 'Целевой уровень этой записи, 1..5']
  "position" integer [not null, note: 'Порядок в плане начиная с 0. Пропуски допустимы, порядок задаётся сортировкой']
  "source" plan_entry_source [not null, note: 'Откуда пришла запись: skill (цель-скил), ship (мастери корабля), certificate, merge (результат объединения или вычитания планов), import']
  "source_type_id" bigint [note: 'Игровой type_id цели: целевой скил при source=skill или корабль при source=ship. Без FK на SDE']
  "source_certificate_id" bigint [note: 'Игровой id сертификата при source=certificate. Без FK на SDE']
  "source_level" smallint [note: 'Уровень цели: уровень целевого скила, уровень мастери корабля или сертификата, 1..5']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`, note: 'Меняется при переупорядочивании']
  Note: 'Упорядоченные уровни скилов плана с источником добавления'
}

Table "assets" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [note: 'Владелец-персонаж (наш characters.id, не игровой id). Заполнен ровно один из character_id и corporation_id.']
  "corporation_id" bigint [note: 'Владелец-корпорация (наш corporations.id, не игровой id).']
  "item_id" bigint [not null, note: 'Игровой item_id из ESI. Уникален в пределах владельца.']
  "type_id" bigint [not null, note: 'Игровой type_id. FK на SDE types нет по соглашению.']
  "quantity" bigint [not null, note: 'ESI quantity as reported: units > 0, -1 for a blueprint original, -2 for a blueprint copy; never 0']
  "location_id" bigint [not null, note: 'Непосредственная локация из ESI: станция, структура, система или item_id родительского контейнера/корабля.']
  "location_type" varchar(16) [not null, note: 'Значение location_type из ESI: station, solar_system, item, other.']
  "location_flag" varchar(64) [not null, note: 'Значение location_flag из ESI как есть (Hangar, CorpSAG1..CorpSAG7, Cargo, слоты и т.п.).']
  "root_location_id" bigint [not null, note: 'Верхняя локация цепочки вложенности (станция, структура или солнечная система). Вычисляется синком при записи.']
  "is_singleton" boolean [not null]
  "is_blueprint_copy" boolean [not null, default: `false`, note: 'Если ESI не прислал поле, пишется false.']
  "name" text [note: 'Пользовательское имя контейнера или корабля из /assets/names. Только для singleton, иначе null.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("type_id") [name: 'ix_assets_type'] }
  indexes { ("root_location_id") [name: 'ix_assets_root_location'] }
  Note: 'Плоский снимок личных и корпоративных ассетов из ESI. Вложенность задаётся через location_id: он равен item_id контейнера или корабля того же владельца.'
}

Table "structures" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "structure_id" bigint [not null, note: 'Игровой structure_id.']
  "name" text [note: 'null, пока структура не разрешена или если доступ к ней закрыт.']
  "solar_system_id" bigint [note: 'Игровой id системы. FK на SDE нет.']
  "type_id" bigint [note: 'Игровой type_id структуры.']
  "owner_corporation_id" bigint [note: 'Игровой corporation_id владельца структуры (не наш corporations.id).']
  "resolved_at" timestamptz [note: 'Время последнего успешного ответа /universe/structures/{id}.']
  "inaccessible_at" timestamptz [note: 'Время последнего ответа 403. Пока значение не null и свежее, повторный запрос не делается. При успешном разрешении сбрасывается в null.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Разрешённые через ESI игроковые структуры (цитадели) в пределах аккаунта: имя и система для отображения локаций ассетов, ордеров и работ.'
}

Table "mails" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null, note: 'Путь до аккаунта для права на забвение и общей ленты']
  "mail_id" bigint [not null, note: 'Игровой mail_id из ESI; уникален в пределах аккаунта']
  "from_id" bigint [not null, note: 'Игровой id отправителя (персонаж, корпорация, альянс или рассылка); без FK']
  "subject" text [not null, default: `''`]
  "body" text [note: 'Тело письма в разметке EVE со ссылками на типы и персонажей; NULL — тело ещё не загружено (заголовки и тело приходят разными запросами ESI)']
  "sent_at" timestamptz [not null, note: 'Поле timestamp из ESI']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("account_id", "sent_at", "id") [name: 'ix_mails_account_sent'] }
  Note: 'Письмо EVE, хранится один раз на аккаунт, даже если оно лежит в ящиках нескольких персонажей'
}

Table "mail_recipients" {
  "id" bigint [pk, not null, increment]
  "mail_id" bigint [not null, note: 'FK на mails.id, а не игровой mail_id']
  "recipient_type" mail_recipient_type [not null, note: 'Enum mail_recipient_type']
  "recipient_id" bigint [not null, note: 'Игровой id получателя; для mailing_list — mailing_lists.mailing_list_id; без FK']
  "created_at" timestamptz [not null, default: `now()`]
  Note: 'Получатели письма: персонажи, корпорации, альянсы, рассылки'
}

Table "mailbox_entries" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null, note: 'FK на characters.id, а не игровой character_id']
  "mail_id" bigint [not null]
  "is_read" boolean [not null, default: `false`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("mail_id") [name: 'ix_mailbox_entries_mail'] }
  Note: 'Нахождение письма в ящике конкретного персонажа с прочитанностью'
}

Table "mail_labels" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null]
  "label_id" integer [not null, note: 'Игровой label_id; уникален в пределах персонажа']
  "name" text [not null]
  "color" varchar(7) [note: 'Hex-цвет из ESI в формате #rrggbb']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Метки почты персонажа из ESI'
}

Table "mailbox_entry_labels" {
  "id" bigint [pk, not null, increment]
  "mailbox_entry_id" bigint [not null]
  "mail_label_id" bigint [not null, note: 'FK на mail_labels.id, а не игровой label_id']
  "created_at" timestamptz [not null, default: `now()`]
  indexes { ("mail_label_id") [name: 'ix_mailbox_entry_labels_label'] }
  Note: 'Связь «письмо в ящике персонажа — метка»'
}

Table "mailing_lists" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null]
  "mailing_list_id" bigint [not null, note: 'Игровой id рассылки']
  "name" text [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Списки рассылки, на которые подписан персонаж'
}

Table "game_notifications" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null]
  "notification_id" bigint [not null, note: 'Игровой notification_id']
  "notification_type" text [not null, note: 'Поле type из ESI; сотни значений, которые CCP расширяет, поэтому text, а не enum']
  "sender_id" bigint [not null, note: 'Игровой id отправителя; без FK']
  "sender_type" varchar(16) [not null, note: 'Поле sender_type из ESI']
  "body" text [note: 'Поле text из ESI (YAML) хранится как есть; не JSONB по JSONB-политике']
  "is_read" boolean [not null, default: `false`]
  "sent_at" timestamptz [not null, note: 'Поле timestamp из ESI']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("character_id", "sent_at", "id") [name: 'ix_game_notifications_character_sent'] }
  Note: 'Игровые уведомления персонажа из ESI для общей ленты'
}

Table "blueprint_items" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [note: 'Владелец-персонаж (наш characters.id); заполнен ровно один из character_id и corporation_id']
  "corporation_id" bigint [note: 'Владелец-корпорация (наш corporations.id в рамках аккаунта)']
  "item_id" bigint [not null, note: 'Игровой item_id экземпляра чертежа']
  "type_id" bigint [not null, note: 'Тип чертежа (SDE blueprints.type_id), без FK']
  "location_id" bigint [not null, note: 'Игровой location_id: станция, структура или item_id контейнера']
  "location_flag" varchar(64) [not null, note: 'location_flag из ESI как есть (Hangar, CorpSAG1, ...)']
  "quantity" integer [not null, note: 'Значение ESI: -1 оригинал, -2 копия, >0 размер стопки оригиналов']
  "is_copy" boolean [not null, note: 'true, если quantity = -2']
  "material_efficiency" smallint [not null, note: 'ME 0..10']
  "time_efficiency" smallint [not null, note: 'TE 0..20']
  "runs" integer [not null, note: 'Оставшиеся прогоны копии; -1 для оригинала']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Экземпляры чертежей персонажа или корпорации из ESI: оригиналы и копии с ME/TE и прогонами'
}

Table "industry_jobs" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [note: 'Владелец-персонаж; заполнен ровно один из character_id и corporation_id']
  "corporation_id" bigint [note: 'Владелец-корпорация']
  "job_id" bigint [not null, note: 'Игровой job_id']
  "installer_id" bigint [not null, note: 'Игровой character_id запустившего, без FK: может быть не из аккаунта']
  "facility_id" bigint [not null, note: 'Игровой id станции или структуры, где идёт работа']
  "location_id" bigint [not null, note: 'station_id из ответа персонажа или location_id из ответа корпорации']
  "activity" blueprint_activity [not null, note: 'activity_id ESI, отображённый на enum']
  "blueprint_id" bigint [not null, note: 'Игровой item_id чертежа, без FK на blueprint_items: чертёж может быть потрачен']
  "blueprint_type_id" bigint [not null]
  "blueprint_location_id" bigint [not null]
  "output_location_id" bigint [not null]
  "product_type_id" bigint [note: 'Тип продукта; null для research']
  "runs" integer [not null]
  "licensed_runs" integer [note: 'Прогоны создаваемых копий (copying/invention)']
  "successful_runs" integer [note: 'Заполняется после завершения invention']
  "probability" numeric(5,4) [note: 'Шанс успеха invention 0..1']
  "cost" numeric(20,2) [note: 'Стоимость запуска в ISK']
  "status" industry_job_status [not null]
  "duration_seconds" integer [not null, note: 'duration из ESI']
  "start_date" timestamptz [not null]
  "end_date" timestamptz [not null, note: 'Плановое окончание; по нему срабатывает событие industry_job_completed']
  "pause_date" timestamptz
  "completed_date" timestamptz
  "completed_character_id" bigint [note: 'Игровой character_id доставившего результат']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("end_date") [name: 'ix_industry_jobs_active_end'] }
  indexes { ("installer_id") [name: 'ix_industry_jobs_installer_open'] }
  Note: 'Производственные работы персонажа или корпорации из ESI: что, где, кем и когда закончится'
}

Table "production_plans" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "name" varchar(200) [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Именованный план производства аккаунта'
}

Table "production_plan_targets" {
  "id" bigint [pk, not null, increment]
  "production_plan_id" bigint [not null]
  "type_id" bigint [not null, note: 'Тип конечного продукта (SDE types), без FK']
  "quantity" numeric(20,0) [not null, note: 'Требуемое количество единиц продукта']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Цели плана: какой продукт и сколько единиц нужно получить'
}

Table "production_plan_nodes" {
  "id" bigint [pk, not null, increment]
  "production_plan_id" bigint [not null]
  "parent_node_id" bigint [note: 'null у корневого узла; корень соответствует цели с тем же type_id']
  "type_id" bigint [not null, note: 'Тип компонента или продукта (SDE types), без FK']
  "quantity" numeric(20,0) [not null, note: 'Требуемое количество для родителя с учётом ME родителя']
  "source" component_source [not null, note: 'Выбранный источник: склад, покупка или производство']
  "activity" blueprint_activity [note: 'Только при source = build: manufacturing или reaction']
  "blueprint_type_id" bigint [note: 'Только при source = build: тип чертежа или формулы (SDE), без FK']
  "material_efficiency" smallint [note: 'ME, принятый в расчёте узла; только при source = build']
  "time_efficiency" smallint [note: 'TE, принятый в расчёте узла; только при source = build']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("production_plan_id", "type_id") [unique, name: 'ux_production_plan_nodes_root'] }
  indexes { ("parent_node_id") [name: 'ix_production_plan_nodes_parent'] }
  Note: 'Дерево декомпозиции плана на компоненты с выбранным источником каждого узла'
}

Table "production_plan_runs" {
  "id" bigint [pk, not null, increment]
  "production_plan_node_id" bigint [not null, note: 'Узел с source = build']
  "character_id" bigint [note: 'Назначенный исполнитель; null — не назначен или персонаж удалён']
  "facility_id" bigint [note: 'Игровой id станции или структуры для запуска; null — не выбрана']
  "runs" integer [not null]
  "planned_start_at" timestamptz [not null]
  "planned_end_at" timestamptz [not null, note: 'Расчётное окончание с учётом TE и бонусов на момент планирования']
  "job_id" bigint [note: 'Игровой job_id фактического запуска после сопоставления с industry_jobs, без FK']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("production_plan_node_id") [name: 'ix_production_plan_runs_node'] }
  indexes { ("character_id", "planned_start_at") [name: 'ix_production_plan_runs_character_start'] }
  Note: 'Расписание запусков: сколько прогонов узла, кем, где и когда запустить'
}

Table "market_orders" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [note: 'Владелец-персонаж (наш characters.id, не игровой id); заполнен ровно один из character_id/corporation_id']
  "corporation_id" bigint [note: 'Владелец-корпорация (наш corporations.id, не игровой id)']
  "order_id" bigint [not null, note: 'Игровой order_id из ESI']
  "type_id" bigint [not null, note: 'Игровой type_id, без FK на SDE']
  "region_id" bigint [not null, note: 'Игровой region_id, без FK на SDE']
  "location_id" bigint [not null, note: 'Игровой id станции или структуры, без FK']
  "kind" order_kind [not null, note: 'buy при is_buy_order=true в ESI, иначе sell']
  "state" order_state [not null, default: `'active'`, note: 'active для маршрута активных ордеров; для истории — state из ESI']
  "price" numeric(20,2) [not null]
  "volume_total" numeric(20,0) [not null]
  "volume_remain" numeric(20,0) [not null]
  "min_volume" numeric(20,0) [note: 'Только для buy-ордеров; null, если ESI не прислал']
  "escrow" numeric(20,2) [note: 'Залог buy-ордера; null для sell']
  "range" varchar(16) [not null, note: 'Дальность ордера из ESI как есть: station, solarsystem, region или число прыжков']
  "duration_days" smallint [not null, note: 'duration из ESI в днях; срок истечения = issued_at + duration_days']
  "issued_at" timestamptz [not null, note: 'issued из ESI']
  "is_corporation" boolean [not null, default: `false`, note: 'Флаг ESI у ордера персонажа: выставлен от имени корпорации; для корпоративных строк всегда true']
  "wallet_division" smallint [note: 'Дивизион кошелька 1..7; только для корпоративных ордеров']
  "issued_by_character_id" bigint [note: 'Игровой character_id выставившего (issued_by); только для корпоративных ордеров, без FK']
  "best_competitor_price" numeric(20,2) [note: 'Лучшая цена чужих ордеров того же type_id/location_id/kind при последней проверке; null — конкурентов нет или книга недоступна']
  "competitors_ahead" integer [note: 'Число чужих ордеров с лучшей ценой при последней проверке; 0 — свой ордер лучший; null — не проверялось']
  "position_checked_at" timestamptz [note: 'Время последнего вычисления позиции по market_book_orders']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("type_id", "location_id") [name: 'ix_market_orders_active_type_location'] }
  Note: 'Ордера персонажей и корпораций из ESI (активные и история за 90 дней) и последняя вычисленная позиция относительно конкурентов'
}

Table "watched_items" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "type_id" bigint [not null, note: 'Игровой type_id, без FK на SDE']
  "region_id" bigint [not null, note: 'Игровой region_id, без FK на SDE']
  "location_id" bigint [note: 'Игровой id станции или структуры; null — наблюдение по всему региону']
  "created_at" timestamptz [not null, default: `now()`]
  Note: 'Товары, за ценами которых аккаунт следит в регионе или конкретной станции/структуре'
}

Table "undercut_events" {
  "id" bigint [pk, not null, increment]
  "market_order_id" bigint [not null]
  "observed_at" timestamptz [not null, note: 'Время проверки, обнаружившей перебитие (совпадает с market_orders.position_checked_at этой проверки)']
  "own_price" numeric(20,2) [not null, note: 'Цена своего ордера на момент наблюдения']
  "competitor_price" numeric(20,2) [not null, note: 'Лучшая цена конкурента, перебившая свой ордер']
  "competitor_order_id" bigint [not null, note: 'Игровой order_id лучшего конкурента; без FK — market_book_orders является кэшем']
  "created_at" timestamptz [not null, default: `now()`]
  Note: 'Факты перебития своего ордера конкурентом, зафиксированные проверкой позиции'
}

Table "market_book_orders" {
  "id" bigint [pk, not null, increment]
  "order_id" bigint [not null, unique, note: 'Игровой id ордера; глобально уникален в EVE; ключ upsert']
  "type_id" bigint [not null, note: 'Игровой id типа, без FK на SDE']
  "region_id" bigint [not null, note: 'Регион синхронизации; для ордеров структур берётся из контекста запроса (watched_items.region_id), так как ESI его не отдаёт']
  "system_id" bigint [note: 'Солнечная система; null для ордеров из /markets/structures, где ESI её не отдаёт']
  "location_id" bigint [not null, note: 'station_id или structure_id, где выставлен ордер']
  "kind" order_kind [not null, note: 'buy при is_buy_order=true в ответе ESI, иначе sell']
  "price" numeric(20,2) [not null, note: 'Цена за единицу, ISK']
  "volume_total" bigint [not null]
  "volume_remain" bigint [not null]
  "min_volume" bigint [not null, default: `1`]
  "range" varchar(16) [not null, note: 'Дальность ордера из ESI: station, solarsystem, region или число прыжков']
  "duration" integer [not null, note: 'Срок ордера в днях']
  "issued" timestamptz [not null, note: 'Время выставления или последнего изменения ордера по ESI']
  "observed_at" timestamptz [not null, default: `now()`, note: 'Время последнего ответа ESI, в котором ордер присутствовал']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("type_id", "location_id") [name: 'ix_market_book_orders_type_location'] }
  indexes { ("observed_at") [name: 'ix_market_book_orders_observed_at'] }
  Note: 'Снимок публичной книги ордеров по регионам и структурам: один ордер ESI — одна строка'
}

Table "market_prices" {
  "id" bigint [pk, not null, increment]
  "type_id" bigint [not null, note: 'Игровой id типа, без FK на SDE']
  "region_id" bigint [not null]
  "location_id" bigint [note: 'Station or structure inside region_id that refines the price; NULL means the region-level price. Not an alternative to region_id, so no CHECK is needed.']
  "best_buy_price" numeric(20,2) [note: 'Максимальная цена buy-ордера; null, если buy-ордеров нет']
  "best_sell_price" numeric(20,2) [note: 'Минимальная цена sell-ордера; null, если sell-ордеров нет']
  "buy_volume" bigint [not null, default: `0`, note: 'Сумма volume_remain всех buy-ордеров']
  "sell_volume" bigint [not null, default: `0`, note: 'Сумма volume_remain всех sell-ордеров']
  "buy_order_count" integer [not null, default: `0`]
  "sell_order_count" integer [not null, default: `0`]
  "observed_at" timestamptz [not null, default: `now()`, note: 'Время снимка книги, из которого посчитаны цены']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Лучшие цены buy/sell и объёмы по типу в регионе или конкретной локации, вычисленные из книги ордеров'
}

Table "market_history" {
  "id" bigint [pk, not null, increment]
  "type_id" bigint [not null, note: 'Игровой id типа, без FK на SDE']
  "region_id" bigint [not null]
  "date" date [not null, note: 'Торговый день EVE (UTC)']
  "average" numeric(20,2) [not null, note: 'Средняя цена сделки за день, ISK']
  "highest" numeric(20,2) [not null]
  "lowest" numeric(20,2) [not null]
  "order_count" bigint [not null, note: 'Число сделок за день']
  "volume" bigint [not null, note: 'Проданное количество единиц за день']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("date") [name: 'ix_market_history_date'] }
  Note: 'Дневная история цен и объёмов по типу и региону из /markets/{region_id}/history'
}

Table "killmails" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "killmail_id" bigint [not null, note: 'Игровой id killmail; уникален в паре с account_id']
  "killmail_hash" varchar(40) [not null, note: 'Хэш ESI (sha1 hex) для GET /killmails/{id}/{hash}/']
  "killmail_time" timestamptz [not null]
  "solar_system_id" bigint [not null, note: 'Игровой id системы, без FK на SDE']
  "moon_id" bigint
  "war_id" bigint
  "destroyed_value" numeric(20,2) [note: 'ISK уничтоженного: корпус жертвы + quantity_destroyed предметов; null, пока цены не рассчитаны']
  "dropped_value" numeric(20,2) [note: 'ISK выпавших предметов (quantity_dropped); null, пока цены не рассчитаны']
  "total_value" numeric(20,2) [note: 'destroyed_value + dropped_value']
  "priced_at" timestamptz [note: 'Когда стоимость рассчитана по market_prices; null — ещё не рассчитана']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("account_id", "killmail_time") [name: 'ix_killmails_account_time'] }
  indexes { ("account_id", "solar_system_id") [name: 'ix_killmails_account_system'] }
  Note: 'Разобранный killmail в рамках аккаунта: когда, где, ссылка ESI и рассчитанная стоимость потери'
}

Table "killmail_participants" {
  "id" bigint [pk, not null, increment]
  "killmail_id" bigint [not null, note: 'FK на killmails.id (наша строка), а не игровой killmail_id']
  "position" smallint [not null, note: '0 — жертва; 1..N — атакующие в порядке массива attackers ответа ESI']
  "role" killmail_role [not null, note: 'victim для position 0; final_blow для атакующего с final_blow=true; иначе attacker']
  "character_id" bigint [note: 'Игровой id; null у NPC и структур']
  "corporation_id" bigint
  "alliance_id" bigint
  "faction_id" bigint
  "ship_type_id" bigint [note: 'type_id корабля или структуры; у жертвы всегда заполнен']
  "weapon_type_id" bigint [note: 'Только у атакующих']
  "damage" integer [not null, note: 'У жертвы — damage_taken, у атакующего — damage_done']
  "security_status" numeric(5,2) [note: 'Только у атакующих (ESI security_status)']
  "ship_value" numeric(20,2) [note: 'Цена корпуса жертвы на момент расчёта; только при role = victim']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("ship_type_id") [name: 'ix_killmail_participants_ship_type'] }
  indexes { ("character_id") [name: 'ix_killmail_participants_character'] }
  indexes { ("killmail_id") [unique, name: 'ux_killmail_participants_victim'] }
  Note: 'Жертва и атакующие killmail: кто, в какой корпорации и альянсе, на чём, чем стрелял, сколько урона'
}

Table "killmail_items" {
  "id" bigint [pk, not null, increment]
  "killmail_id" bigint [not null]
  "parent_item_id" bigint [note: 'Контейнер, в котором лежал предмет (вложенный items[] в ESI); null — верхний уровень']
  "position" integer [not null, note: 'Порядковый номер при обходе дерева items ESI в глубину, с 0; сквозной в пределах killmail']
  "type_id" bigint [not null]
  "flag" integer [not null, note: 'Слот или отсек по ESI (inventory flag)']
  "singleton" integer [not null, note: 'ESI singleton: 0 — стек, 2 — BPC и т.п.']
  "quantity_destroyed" bigint [not null, default: `0`]
  "quantity_dropped" bigint [not null, default: `0`]
  "unit_price" numeric(20,2) [note: 'Цена за единицу на момент расчёта; null — не рассчитана или нет цены']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  Note: 'Предметы жертвы (фит, груз, содержимое контейнеров) с количеством уничтоженного и выпавшего'
}

Table "character_killmails" {
  "id" bigint [pk, not null, increment]
  "character_id" bigint [not null, note: 'FK на characters.id (наша строка), не игровой character_id']
  "killmail_id" bigint [not null]
  "role" killmail_role [not null, note: 'Роль персонажа в killmail: victim — потеря; attacker или final_blow — убийство']
  "killmail_time" timestamptz [not null, note: 'Копия killmails.killmail_time (неизменна) для ленты персонажа по индексу без join']
  "created_at" timestamptz [not null, default: `now()`]
  indexes { ("character_id", "killmail_time") [name: 'ix_character_killmails_character_time'] }
  indexes { ("killmail_id") [name: 'ix_character_killmails_killmail'] }
  Note: 'Связь персонажа аккаунта с killmail: потеря или убийство, основа ленты персонажа'
}

Table "notification_recipients" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "channel" channel_kind [not null, note: 'PG enum channel_kind']
  "label" varchar(100) [not null, note: 'Имя получателя, которое пользователь видит в UI']
  "target_encrypted" bytea [note: 'Шифротекст адреса: chat_id Telegram/Max, URL вебхука Discord, номер WhatsApp. Для web_push всегда NULL: адреса берутся из push_subscriptions аккаунта']
  "is_enabled" boolean [not null, default: `true`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("account_id") [name: 'ix_notification_recipients_account'] }
  Note: 'Канал доставки аккаунта: тип канала и зашифрованный адрес (чат, вебхук, номер)'
}

Table "push_subscriptions" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "endpoint" text [not null, unique, note: 'URL push-сервиса из PushSubscription.endpoint']
  "p256dh" text [not null, note: 'Публичный ключ клиента (base64url), не является секретом']
  "auth_encrypted" bytea [not null, note: 'Шифротекст auth-секрета подписки']
  "user_agent" varchar(500) [note: 'Для отображения списка устройств в UI']
  "last_success_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("account_id") [name: 'ix_push_subscriptions_account'] }
  Note: 'Подписка браузера Web Push (endpoint и ключи), на которую рассылаются web_push-доставки аккаунта'
}

Table "notification_rules" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "name" varchar(100) [not null]
  "event_kind" event_kind [not null, note: 'PG enum event_kind']
  "all_characters" boolean [not null, default: `true`, note: 'true — правило действует на всех персонажей аккаунта, и notification_rule_characters игнорируется; false — только на персонажей из notification_rule_characters']
  "is_enabled" boolean [not null, default: `true`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("account_id", "event_kind") [name: 'ix_notification_rules_account_kind'] }
  indexes { ("account_id", "id") [unique, name: 'uq_notification_rules_account_id_id'] }
  Note: 'Правило подписки: какой вид события по каким персонажам аккаунта отправлять'
}

Table "notification_rule_recipients" {
  "id" bigint [pk, not null, increment]
  "notification_rule_id" bigint [not null]
  "notification_recipient_id" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  indexes { ("notification_recipient_id") [name: 'ix_notification_rule_recipients_recipient'] }
  Note: 'Связь правила с получателями, которым оно доставляет события'
}

Table "notification_rule_characters" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null, note: 'Tenant key: the rule and the character must belong to this account']
  "notification_rule_id" bigint [not null]
  "character_id" bigint [not null, note: 'FK на characters.id (наша строка), а не игровой character_id']
  "created_at" timestamptz [not null, default: `now()`]
  indexes { ("character_id") [name: 'ix_notification_rule_characters_character'] }
  Note: 'Персонажи, которыми ограничено правило при all_characters = false'
}

Table "notification_events" {
  "id" bigint [pk, not null, increment]
  "account_id" bigint [not null]
  "character_id" bigint [note: 'Персонаж-источник события, по нему фильтруют notification_rule_characters. NULL — событие корпоративного ордера или работы без привязки к персонажу; оно подходит только правилам с all_characters = true']
  "event_kind" event_kind [not null, note: 'PG enum event_kind']
  "dedup_key" varchar(200) [not null, note: 'Детерминированный ключ из игровых id, формат в notes']
  "payload" jsonb [not null, note: 'Снимок данных для текста сообщения; по нему не фильтруют и не ищут']
  "occurred_at" timestamptz [not null, note: 'Игровое время события (окончание скила, работы, observed_at перебития, время письма)']
  "matched_at" timestamptz [note: 'Когда правила сопоставлены и созданы доставки; NULL — ждёт обработки']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("created_at") [name: 'ix_notification_events_unmatched'] }
  indexes { ("account_id", "occurred_at") [name: 'ix_notification_events_account_occurred'] }
  Note: 'Обнаруженное событие с ключом дедупликации и payload для рендера сообщения'
}

Table "notification_deliveries" {
  "id" bigint [pk, not null, increment]
  "notification_event_id" bigint [not null]
  "notification_recipient_id" bigint [not null]
  "status" delivery_status [not null, default: `'pending'`, note: 'PG enum delivery_status']
  "attempt_count" smallint [not null, default: `0`]
  "next_attempt_at" timestamptz [default: `now()`, note: 'Когда воркер берёт доставку; задан только при pending/failed']
  "last_attempt_at" timestamptz
  "sent_at" timestamptz
  "last_error" text [note: 'Текст ошибки последней неудачной попытки, без секретов и адресов']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("next_attempt_at") [name: 'ix_notification_deliveries_due'] }
  indexes { ("notification_recipient_id") [name: 'ix_notification_deliveries_recipient'] }
  Note: 'Доставка события конкретному получателю: статус, попытки, расписание ретрая'
}

Table "esi_responses" {
  "id" bigint [pk, not null, increment]
  "cache_key" bytea [not null, unique, note: 'SHA-256 (32 байта) от канонической строки: route +  \n  + params +  \n  + coalesce(character_id::text,   ); ключ upsert']
  "character_id" bigint [note: 'Внутренний characters.id, чьим токеном сделан запрос; null для публичных маршрутов']
  "route" varchar(200) [not null, note: 'Шаблон маршрута ESI с версией, например /v4/characters/{character_id}/skills/']
  "params" text [not null, default: `''`, note: 'Каноническая строка параметров пути и запроса (ключи отсортированы, включая page); входит в cache_key']
  "etag" varchar(200) [note: 'Значение заголовка ETag как есть, с кавычками; отправляется в If-None-Match']
  "expires_at" timestamptz [not null, note: 'Из заголовка Expires; до этого момента запрос в ESI не выполняется']
  "last_modified_at" timestamptz [note: 'Из заголовка Last-Modified, если ESI его прислал']
  "pages" smallint [note: 'Из заголовка X-Pages для постраничных маршрутов; null, если заголовка нет']
  "body" jsonb [not null, note: 'Тело успешного ответа (2xx) без изменений; непрозрачный внешний payload']
  "fetched_at" timestamptz [not null, default: `now()`, note: 'Время последнего обращения к ESI, включая ответ 304, который только продлевает expires_at']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  indexes { ("character_id") [name: 'ix_esi_responses_character_id'] }
  indexes { ("expires_at") [name: 'ix_esi_responses_expires_at'] }
  Note: 'Последний успешный ответ ESI по ключу маршрута и параметров с ETag и сроком годности для условных запросов'
}

