# Copy to .env and fill in. Never commit .env.

# EVE application (developers.eveonline.com). The callback must match the registered one exactly.
# The portal accepts the http scheme only for localhost, so development logs in through the
# localhost relay (occc-eve-relay, port 64321 on the machine you browse from) instead of the
# compose host name.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:64321/api/v1/auth/eve/callback

# Session and token encryption. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Postgres inside the compose network
DATABASE_URL=postgresql+psycopg://occc:occc@db:5432/occc
